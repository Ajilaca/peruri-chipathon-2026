../../rtl/arith/modmul_montgomery.sv
../../rtl/arith/modmul_sel.sv
../../rtl/arith/butterfly_c4.sv
../../rtl/arith/lazy_bfly_io.sv
../../rtl/arith/modmul_barrett_lazy.sv
../../rtl/arith/butterfly_c4_lazy.sv
../../rtl/mem/poly_mem_multiport_pipe.sv
../../rtl/ntt/ntt_core_c4.sv
../../rtl/ntt/ntt_core_c4a.sv
../../rtl/ntt/ntt_core_c4b_b.sv
../../rtl/ntt/ntt_core_c4b_m.sv
../../rtl/ntt/ntt_core_c4c.sv
../phase01-ntt/ntt_core_props.sv
ntt_core_c4_formal_top.sv
