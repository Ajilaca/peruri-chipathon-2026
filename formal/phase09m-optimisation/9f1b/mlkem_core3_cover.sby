# formal/phase09m-optimisation/9f1b/mlkem_core3_cover.sby
# Phase 9F S1b V7: reachability (cover) of mlkem_core3_formal_top.sv: a sidecar digest word can be written (the J job of Decaps: about 150 cycles) and the sidecar can issue a read; the completion of whole programs is not covered here (the background job alone needs more than 200 cycles in KeyGen and Encaps).

[options]
mode cover
depth 200

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL stubs_9c.sv stubs_9m1.sv mlkem_ram.sv mlkem_ctl_rom2.sv mlkem_core3.sv mlkem_core3_formal_top.sv --top mlkem_core3_formal_top
prep -top mlkem_core3_formal_top
memory_map -rom-only

[files]
../../phase09-integration/9c/stubs_9c.sv
../9m1/stubs_9m1.sv
../../../rtl/mlkem/mlkem_ram.sv
../../../rtl/mlkem/mlkem_ctl_rom2.sv
../../../rtl/mlkem/mlkem_core3.sv
mlkem_core3_formal_top.sv
