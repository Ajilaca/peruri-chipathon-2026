# formal/phase09m-optimisation/9i4/mlkem_core4_safety.sby
# Phase 9I item 4 V8 (derived from 9f1b): properties E1 (with the interlock register and the sticky done flag), S1-S7, B1-B7 of mlkem_core4_formal_top.sv (P1 is a bounded check in the bmc file) of mlkem_core4_formal_top.sv (two copies of the controller with the background hash sidecar, stubs for the sub-blocks; induction, depth 12). Control and range only.

[options]
mode prove
depth 12

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL stubs_9c.sv stubs_9m1.sv stubs_9i4.sv mlkem_ram.sv mlkem_ctl_rom3.sv mlkem_core4.sv mlkem_core4_formal_top.sv --top mlkem_core4_formal_top -G P1_ON=0
prep -top mlkem_core4_formal_top
memory_map -rom-only

[files]
../../phase09-integration/9c/stubs_9c.sv
../9m1/stubs_9m1.sv
stubs_9i4.sv
../../../rtl/mlkem/mlkem_ram.sv
../../../rtl/mlkem/mlkem_ctl_rom3.sv
../../../rtl/mlkem/mlkem_core4.sv
mlkem_core4_formal_top.sv
