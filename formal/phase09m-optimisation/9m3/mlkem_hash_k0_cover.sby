# formal/phase09m-optimisation/9m3/mlkem_hash_k0_cover.sby
# Phase 9M-3 V5 (anti-vacuity): reachability of the covered states in mlkem_hash_k0_formal_top.sv (cover, depth 40) with the sponge replaced by its protocol stub keccak_sponge_stub.sv. Control and result only.

[options]
mode cover
depth 40

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL keccak_sponge_stub.sv mlkem_hash.sv mlkem_hash_k0_formal_top.sv --top mlkem_hash_k0_formal_top
prep -top mlkem_hash_k0_formal_top

[files]
keccak_sponge_stub.sv
../../../rtl/mlkem/mlkem_hash.sv
mlkem_hash_k0_formal_top.sv
