# formal/phase09-integration/9b/mlkem_fo_cmp_cover.sby
# Phase 9b V8 (anti-vacuity): reachability of the covered states in mlkem_fo_cmp_formal_top.sv (cover, depth 40). Control and result only.

[options]
mode cover
depth 40

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL mlkem_fo_cmp.sv mlkem_fo_cmp_formal_top.sv --top mlkem_fo_cmp_formal_top
prep -top mlkem_fo_cmp_formal_top

[files]
../../../rtl/mlkem/mlkem_fo_cmp.sv
mlkem_fo_cmp_formal_top.sv
