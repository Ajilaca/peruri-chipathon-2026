# formal/phase09-integration/9c/mlkem_core_safety.sby
# Phase 9c (Amendment A2): properties E1, S1-S7 of mlkem_core_formal_top.sv (two copies of the controller, stubs for the sub-blocks; induction, depth 12). Control and range only.

[options]
mode prove
depth 12

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL stubs_9c.sv mlkem_ram.sv mlkem_ctl_rom.sv mlkem_core.sv mlkem_core_formal_top.sv --top mlkem_core_formal_top
prep -top mlkem_core_formal_top
memory_map -rom-only

[files]
stubs_9c.sv
../../../rtl/mlkem/mlkem_ram.sv
../../../rtl/mlkem/mlkem_ctl_rom.sv
../../../rtl/mlkem/mlkem_core.sv
mlkem_core_formal_top.sv
