# formal/phase09-integration/9c/mlkem_core_cover_deep.sby
# Phase 9c (Amendment A2): reachability of the covered states (cover mode, depth 480), the anti-vacuity run of the proof. Control and range only.

[options]
mode cover
depth 480

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL -D DEEP stubs_9c.sv mlkem_ram.sv mlkem_ctl_rom.sv mlkem_core.sv mlkem_core_formal_top.sv --top mlkem_core_formal_top
prep -top mlkem_core_formal_top
memory_map -rom-only

[files]
stubs_9c.sv
../../../rtl/mlkem/mlkem_ram.sv
../../../rtl/mlkem/mlkem_ctl_rom.sv
../../../rtl/mlkem/mlkem_core.sv
mlkem_core_formal_top.sv
