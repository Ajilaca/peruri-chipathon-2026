# formal/phase08-keccak-stream/8d/kpke_sched_smp_safety_overlap.sby
# Phase 8d V7: control properties F1-F5 of kpke_sched_smp_formal_top.sv (rtl/sched/kpke_sched_smp.sv, STREAM_A = 1, OVERLAP = 1 (the 8d build: arbitration, non-blocking SMPN, WAIT); the NTT core abstracted, the sampler replaced by keccak_sampler_stub.sv).

[options]
mode prove
depth 12

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL -G OVERLAP=1 ntt_pkg.sv pipe_delay.sv modmul_barrett.sv gamma_rom.sv kpke_smp_prog_rom.sv poly_store_smp.sv pwm_unit.sv kpke_sched_smp.sv keccak_sampler_stub.sv kpke_sched_smp_formal_top.sv --top kpke_sched_smp_formal_top
prep -top kpke_sched_smp_formal_top
memory_map -rom-only

