# quartus/phase06_sched/P6.qsf -- Phase 6 (evidence/phase06/test_plan.md V9): K-PKE arithmetic sequencer with the S7 NTT/INTT core, kernel-only compile
# (virtual pins, as Phases 1-5M), 40.000 ns (P.sdc, identical to quartus/phase05m_memsched/M.sdc), Quartus defaults, seed 1.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY kpke_sched_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_P6
set_global_assignment -name SDC_FILE P.sdc

set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ntt/ntt_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ntt/twiddle_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/twiddle_rom_half.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/mem/bank_map_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ntt/pipe_delay.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ntt/modmul_reduce_staged.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/modmul_fold.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/modmul_barrett.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/modmul_montgomery.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/modmul_sel.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/half_mod.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/arith/butterfly_m6.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/mem/poly_mem_multiport_split.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ntt/ntt_core_s7.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ntt/ntt_core_s7_p7.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sched/gamma_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sched/kpke_prog_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sched/poly_store.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sched/pwm_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sched/kpke_sched.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sched/kpke_sched_top.sv

set_instance_assignment -name VIRTUAL_PIN ON -to clk_i
set_instance_assignment -name VIRTUAL_PIN ON -to rst_ni
set_instance_assignment -name VIRTUAL_PIN ON -to prog_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to start_i
set_instance_assignment -name VIRTUAL_PIN ON -to busy_o
set_instance_assignment -name VIRTUAL_PIN ON -to done_o
set_instance_assignment -name VIRTUAL_PIN ON -to tb_we_i
set_instance_assignment -name VIRTUAL_PIN ON -to tb_slot_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to tb_addr_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to tb_wdata_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to tb_rdata_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cnt_ntt_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cnt_intt_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cnt_pwm_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to bank_overflow_o

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"