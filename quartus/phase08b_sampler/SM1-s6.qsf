# quartus/phase08b_sampler/SM1-s6.qsf -- Phase 8b stage W1 (evidence/phase08/8b/test_plan_8b.md V11): keccak_sampler (streaming SampleNTT and CBD2 on the sponge, one coefficient per cycle),
# CORE_R2 = 1 (C5 sponge keccak_sponge_r2), kernel-only compile (virtual pins, as Phases 1-8a), 40.000 ns (C.sdc), Quartus defaults, seed 6.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY keccak_sampler
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_SM1-s6
set_global_assignment -name SDC_FILE C.sdc
set_parameter -name CORE_R2 1

set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/keccak/keccak_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/keccak/keccak_round.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/keccak/keccak_f1600.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/keccak/keccak_sponge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/keccak/keccak_f1600_r2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/keccak/keccak_sponge_r2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sample/sample_ntt_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sample/cbd2_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sample/keccak_sampler.sv

set_instance_assignment -name VIRTUAL_PIN ON -to clk_i
set_instance_assignment -name VIRTUAL_PIN ON -to rst_ni
set_instance_assignment -name VIRTUAL_PIN ON -to start_i
set_instance_assignment -name VIRTUAL_PIN ON -to kind_i
set_instance_assignment -name VIRTUAL_PIN ON -to len_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to abort_i
set_instance_assignment -name VIRTUAL_PIN ON -to in_valid_i
set_instance_assignment -name VIRTUAL_PIN ON -to in_ready_o
set_instance_assignment -name VIRTUAL_PIN ON -to in_data_i[*]
set_instance_assignment -name VIRTUAL_PIN ON -to coef_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to coef_ready_i
set_instance_assignment -name VIRTUAL_PIN ON -to coef_data_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to coef_last_o
set_instance_assignment -name VIRTUAL_PIN ON -to bytes_o[*]
set_instance_assignment -name VIRTUAL_PIN ON -to busy_o
set_instance_assignment -name VIRTUAL_PIN ON -to done_o
set_instance_assignment -name VIRTUAL_PIN ON -to perm_cnt_o[*]

set_global_assignment -name SEED 6
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
